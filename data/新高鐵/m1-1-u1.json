      "grammar": {
        "tips": [
          {
            "label": "名詞所有格",
            "text": "單數名詞通常加 's；以 s 結尾的複數名詞只加 '；不規則複數仍加 's。"
          },
          {
            "label": "共同與分別所有",
            "text": "A and B's 表示共同擁有；A's and B's 表示兩人分別擁有。"
          },
          {
            "label": "be 動詞",
            "text": "I 搭配 am，單數搭配 is，you 或複數搭配 are；否定時在 be 後加 not。"
          },
          {
            "label": "問句",
            "text": "一般問句把 be 移到句首；詢問人物時使用 Who + be + 主詞？"
          }
        ],
        "notes": [
          {
            "title": "一般名詞的所有格",
            "rule": "單數名詞加 's；以 s 結尾的複數名詞只加 '；不以 s 結尾的不規則複數加 's。",
            "description": "所有格表示人與事物的所屬關係。兩人共同擁有時，只在第二個名字後加 's；分別擁有時，兩個名字都加 's。",
            "examples": [
              "Peter's book is new.",
              "The boys' jackets are blue.",
              "The women's bags are here.",
              "Ruby and Kate's brother is Fred.",
              "Amy's and Ella's aunts are friends."
            ]
          },
          {
            "title": "含 be 動詞的直述句與否定句",
            "rule": "主詞 + am / are / is + 名詞或形容詞；否定句在 be 後加 not。",
            "description": "am not 不可縮寫；is not 可縮寫為 isn't，are not 可縮寫為 aren't。",
            "examples": [
              "I am a student.",
              "My mother is beautiful.",
              "He isn't an office worker.",
              "They aren't classmates."
            ]
          },
          {
            "title": "be 動詞的一般問句與答句",
            "rule": "Be 動詞 + 主詞 + 名詞或形容詞？",
            "description": "把直述句的 be 動詞移到句首。肯定簡答不可縮寫；否定簡答可使用 isn't 或 aren't。",
            "examples": [
              "Is Helen a writer? Yes, she is.",
              "Are they cousins? No, they aren't.",
              "Am I your new classmate? Yes, you are."
            ]
          },
          {
            "title": "否定疑問句",
            "rule": "Isn't / Aren't + 主詞 + 名詞或形容詞？",
            "description": "否定疑問句常用來確認原先的想法；回答仍依實際情況使用 Yes 或 No。",
            "examples": [
              "Isn't he your uncle? Yes, he is.",
              "Aren't they students? No, they aren't."
            ]
          },
          {
            "title": "以 who 為首的問句",
            "rule": "Who + am / are / is + 主詞？",
            "description": "who 用來詢問姓名、身分或關係。回答可使用姓名、職業、關係，或以同位語同時補充姓名與關係。",
            "examples": [
              "Who's she? She is Miranda.",
              "Who's he? He's my English teacher.",
              "Who is the girl? She is my sister Sandy."
            ]
          }
