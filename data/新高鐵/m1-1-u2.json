      "grammar": {
        "tips": [
          {
            "label": "單複數",
            "text": "單數可數名詞須有限定詞；兩個以上用複數名詞。"
          },
          {
            "label": "指示詞",
            "text": "this／that 接單數與 is；these／those 接複數與 are。"
          },
          {
            "label": "位置",
            "text": "用介系詞說明位置；Where 用來詢問位置。"
          }
        ],
        "notes": [
          {
            "title": "可數名詞複數",
            "rule": "一般加 -s；部分字尾加 -es、改 -y 為 -ies 或改為 -ves；也有不規則變化。",
            "description": "名詞數量超過一個時，須使用正確複數形式。",
            "examples": [
              "cookie → cookies",
              "baby → babies",
              "mouse → mice"
            ]
          },
          {
            "title": "單數句與複數句",
            "rule": "this／that + is；these／those + are。",
            "description": "指示詞、be 動詞與名詞數量必須一致。",
            "examples": [
              "This is a pencil.",
              "Those are pencils."
            ]
          },
          {
            "title": "what 與 where 問句",
            "rule": "What 問物品；Where 問位置。",
            "description": "回答位置時可用完整句或「介系詞＋名詞」。",
            "examples": [
              "What is it? It is a brush.",
              "Where is the cat? It is under the sofa."
            ]
          },
          {
            "title": "表示位置的介系詞",
            "rule": "介系詞 + 名詞表示位置。",
            "description": "本課重點包括 on、in、under、near、between、behind、in front of、inside、at、above。",
            "examples": [
              "The bird is above the box.",
              "The dog is behind the door."
            ]
          },
          {
            "title": "複數字尾的發音",
            "rule": "複數字尾依單數名詞的尾音讀成 /s/、/z/ 或 /ɪz/。",
            "description": "無聲子音後通常讀 /s/；母音或有聲子音後通常讀 /z/；s、sh、ch、z 等音後讀 /ɪz/。",
            "examples": [
              "gifts /s/",
              "dogs /z/",
              "brushes /ɪz/"
            ]
          },
          {
            "title": "定冠詞與不定冠詞",
            "rule": "雙方都知道的特定事物用 the；不特定的單數事物用 a 或 an。",
            "description": "Where 問句常詢問特定的人或物，因此名詞前常使用 the 或所有格。",
            "examples": [
              "Where is the library?",
              "The woman is next to a door."
            ]
          }
        ],
